// site.cro — the cococopi website, rendered entirely in Corros.
//
// Every page is built from glazecraft components (vendored in vendor/glaze.cro)
// and written out as static HTML by this script — no JavaScript, no build
// tools, nothing but the language. The output lands in dist/.
//
//   corros site.cro          (run from the repo root)
//
// On Vercel, deploy/build.sh installs Corros and runs exactly this.

adopt "vendor/glaze.cro"

// --- project data ---------------------------------------------------------------

forge projects = [
  { "name": "corros", "slug": "corros", "accent": "amber", "icon": "⚒",
    "tagline": "a scripting language forged from scratch",
    "desc": "The language that builds everything here: its own lexer, bytecode compiler, virtual machine, and an AOT backend that compiles Corros straight to C. Self-hosting — Corros compiles Corros.",
    "tags": ["language", "compiler", "vm", "self-hosting", "aot"],
    "repo": "https://github.com/CocoCopi/corros",
    "install": "curl -fsSL https://raw.githubusercontent.com/CocoCopi/corros/main/install.sh | sh" },
  { "name": "courierforge", "slug": "courierforge", "accent": "sky", "icon": "✉",
    "tagline": "a requests-style HTTP client",
    "desc": "GET, POST, PUT, DELETE, binary-safe downloads, query strings, and a full JSON parser/serializer — written entirely in Corros with zero dependencies.",
    "tags": ["http", "json", "client", "networking"],
    "repo": "https://github.com/CocoCopi/courierforge",
    "install": "curl -fsSL https://raw.githubusercontent.com/CocoCopi/courierforge/main/install.sh | sh" },
  { "name": "brothforge", "slug": "brothforge", "accent": "lime", "icon": "🍲",
    "tagline": "a BeautifulSoup-style HTML parser",
    "desc": "Parse any HTML into a node tree, then query it with find, find_all, CSS-ish selectors, entity decoding, implied closing, and pretty printing.",
    "tags": ["html", "parsing", "scraping", "selectors"],
    "repo": "https://github.com/CocoCopi/brothforge",
    "install": "curl -fsSL https://raw.githubusercontent.com/CocoCopi/brothforge/main/install.sh | sh" },
  { "name": "oremath", "slug": "oremath", "accent": "emerald", "icon": "⛏",
    "tagline": "a NumPy-style ndarray library",
    "desc": "Pure-Corros tensors with numpy broadcasting, matmul, axis reductions, and from-scratch exp/log/tanh/sigmoid — the reference implementation for the cryotorch core.",
    "tags": ["math", "tensors", "numpy", "pure-corros"],
    "repo": "https://github.com/CocoCopi/oremath",
    "install": "curl -fsSL https://raw.githubusercontent.com/CocoCopi/oremath/main/install.sh | sh" },
  { "name": "cryoquench", "slug": "cryoquench", "accent": "cyan", "icon": "❄",
    "tagline": "a from-scratch deep learning engine",
    "desc": "Autograd, layers, optimizers, and a threaded vectorized C core — 512³ matmul at 8.6 GFLOPS, 34× faster than naive C on a phone. The engine behind cryotorch.",
    "tags": ["ml", "autograd", "c-core", "high-performance"],
    "repo": "https://github.com/CocoCopi/cryoquench",
    "install": "curl -fsSL https://raw.githubusercontent.com/CocoCopi/cryoquench/main/install.sh | sh" },
  { "name": "cryotorch", "slug": "cryotorch", "accent": "violet", "icon": "🔬",
    "tagline": "a PyTorch-shaped deep learning API",
    "desc": "tensor(), nn-style layers, Adam/SGD, .backward(), save/load — a familiar torch API over the CryoQuench engine. XOR trains to a perfect truth table in 0.05s.",
    "tags": ["ml", "autograd", "nn", "optimizers"],
    "repo": "https://github.com/CocoCopi/cryotorch",
    "install": "curl -fsSL https://raw.githubusercontent.com/CocoCopi/cryotorch/main/install.sh | sh" },
  { "name": "glazecraft", "slug": "glazecraft", "accent": "rose", "icon": "🍯",
    "tagline": "a React-style frontend framework",
    "desc": "Components, props, use_state hooks, nested stateful components, SSR with hydration, and live updates through a tiny browser runtime. This site is rendered by it.",
    "tags": ["frontend", "components", "hooks", "ssr", "live-updates"],
    "repo": "https://github.com/CocoCopi/glazecraft",
    "install": "curl -fsSL https://raw.githubusercontent.com/CocoCopi/glazecraft/main/install.sh | sh" },
  { "name": "kilncraft", "slug": "kilncraft", "accent": "orange", "icon": "🏺",
    "tagline": "an Express-style web framework",
    "desc": "Routing with :params, middleware chains, JSON bodies, sessions, and static files — a backend framework written entirely in Corros on the language's socket builtins.",
    "tags": ["backend", "http", "server", "middleware", "sessions"],
    "repo": "https://github.com/CocoCopi/kilncraft",
    "install": "curl -fsSL https://raw.githubusercontent.com/CocoCopi/kilncraft/main/install.sh | sh" },
  { "name": "crucible", "slug": "crucible", "accent": "red", "icon": "🔥",
    "tagline": "a local LLM forge",
    "desc": "Pull any GGUF model from Hugging Face, get a RAM-fit recommendation across your whole catalog, and serve a streaming chat API — all in Corros.",
    "tags": ["llm", "gguf", "server", "streaming"],
    "repo": "https://github.com/CocoCopi/crucible",
    "install": "curl -fsSL https://raw.githubusercontent.com/CocoCopi/crucible/main/install.sh | sh" }
]

// --- shared components -------------------------------------------------------------

craft _brand() {
  return el("a", { "class": "brand", "href": "/" }, [
    el("span", { "class": "flame" }, ["🔥"]),
    el("span", { "class": "brand-name" }, ["~/cococopi"])
  ])
}

craft _nav() {
  return el("header", { "class": "nav" }, [
    el("div", { "class": "nav-inner" }, [
      _brand(),
      el("input", { "type": "checkbox", "id": "nav-toggle", "class": "nav-toggle" }, []),
      el("label", { "class": "nav-burger", "for": "nav-toggle" }, [
        el("span", {}, []), el("span", {}, []), el("span", {}, [])
      ]),
      el("nav", { "class": "nav-links" }, [
        el("a", { "href": "/#projects" }, ["//projects"]),
        el("a", { "href": "/#stack" }, ["//stack"]),
        el("a", { "href": "/#about" }, ["//about"]),
        el("a", { "class": "nav-cta", "href": "https://github.com/cococopi" }, ["fork me ↗"])
      ])
    ])
  ])
}

craft _footer() {
  return el("footer", { "class": "footer" }, [
    el("div", { "class": "footer-inner" }, [
      el("pre", { "class": "logo-ascii" }, [
        "cococopi" + "\n" + "---------" + "\n" + "an ecosystem," + "\n" + "one language."
      ]),
      el("p", { "class": "footer-note" }, [
        "every line of this site is forged in ",
        el("a", { "href": "https://github.com/CocoCopi/corros" }, ["corros"]),
        " — components by glazecraft, no javascript, no dependencies."
      ]),
      el("p", { "class": "footer-cred" }, ["© 2026 cococopi · built to prove the language"])
    ])
  ])
}

craft _tags(p) {
  forge out = []
  each t in p["tags"] { out.shove(el("span", { "class": "chip" }, [t])) }
  return out
}

craft _install_snippet(p) {
  return el("div", { "class": "install" }, [
    el("div", { "class": "install-head" }, [
      el("span", { "class": "install-lab" }, ["$ one-line install"]),
      el("span", { "class": "install-os" }, ["anywhere corros runs"])
    ]),
    el("pre", { "class": "install-code" }, [
      el("span", { "class": "ps1" }, ["$"]),
      " " + p["install"]
    ])
  ])
}

// --- hero: embers + typing terminal ---------------------------------------------------

craft _embers() {
  forge lefts = ["8%","15%","23%","31%","40%","48%","57%","64%","72%","80%","88%","95%"]
  forge dels  = ["0s","0.8s","1.6s","0.4s","2.1s","0.9s","1.2s","2.4s","0.3s","1.8s","0.6s","1.1s"]
  forge durs  = ["5s","7s","6s","8s","5s","9s","6s","7s","8s","5s","6s","9s"]
  forge sizes = ["3px","2px","4px","2px","3px","5px","2px","3px","4px","2px","3px","2px"]
  forge out = []
  forge i = 0
  whilst i < 12 {
    out.shove(el("i", { "class": "ember", "style": "left:" + lefts[i] + ";animation-delay:" + dels[i] + ";animation-duration:" + durs[i] + ";width:" + sizes[i] + ";height:" + sizes[i] + ";" }, []))
    i = i + 1
  }
  return out
}

craft _terminal() {
  return el("div", { "class": "term" }, [
    el("div", { "class": "term-bar" }, [
      el("span", { "class": "td td-r" }, []),
      el("span", { "class": "td td-y" }, []),
      el("span", { "class": "td td-g" }, []),
      el("span", { "class": "term-title" }, ["forge.cro — real corros"])
    ]),
    el("pre", { "class": "term-body" }, [
      el("span", { "class": "ln" }, [el("span", { "class": "tk" }, ["forge"]), " flame = ", el("span", { "class": "tk" }, ["new"]), "()"]),
      el("span", { "class": "ln" }, [el("span", { "class": "tk" }, ["whilst"]), " flame.", el("span", { "class": "fn" }, ["burns"]), "() {"]),
      el("span", { "class": "ln ln-i" }, ["  flame.", el("span", { "class": "fn" }, ["feed"]), "(", el("span", { "class": "ts" }, ["\"corros\""]), ")"]),
      el("span", { "class": "ln ln-i tw" }, ["  ", el("span", { "class": "fn" }, ["speak"]), "(", el("span", { "class": "ts" }, ["\"hello, corros\""]), ")", el("span", { "class": "caret" }, [])]),
      el("span", { "class": "ln" }, ["}"])
    ])
  ])
}

craft _hero() {
  return el("section", { "class": "hero" }, [
    el("div", { "class": "embers" }, _embers()),
    el("div", { "class": "hero-inner" }, [
      el("p", { "class": "hero-kicker" }, ["// built to prove the language"]),
      el("h1", { "class": "hero-title" }, [
        "forged in ",
        el("span", { "class": "grad flick" }, ["corros"])
      ]),
      el("p", { "class": "hero-sub" }, [
        "corros is a scripting language written from scratch — and it now ships its own ",
        "http client, html parser, numpy-style math, deep-learning engine, pytorch-shaped api, ",
        "react-style frontend framework, express-style backend, and a local llm forge. ",
        "this website is rendered by that frontend framework."
      ]),
      el("div", { "class": "hero-cta" }, [
        el("a", { "class": "btn btn-primary", "href": "/#projects" }, ["see the projects"]),
        el("a", { "class": "btn btn-ghost", "href": "https://github.com/cococopi" }, ["github ↗"])
      ]),
      _terminal(),
      el("div", { "class": "hero-stats" }, [
        el("div", { "class": "ingot" }, [el("b", {}, ["9"]), el("span", {}, ["open-source projects"])]),
        el("div", { "class": "ingot" }, [el("b", {}, ["1"]), el("span", {}, ["language built from scratch"])]),
        el("div", { "class": "ingot" }, [el("b", {}, ["0"]), el("span", {}, ["third-party dependencies"])]),
        el("div", { "class": "ingot" }, [el("b", {}, ["8.6"]), el("span", {}, ["GFLOPS matmul, on a phone"])])
      ])
    ])
  ])
}

// --- marquee ------------------------------------------------------------------------

craft _marquee() {
  forge names = ["corros","courierforge","brothforge","oremath","cryoquench","cryotorch","glazecraft","kilncraft","crucible"]
  forge chunk = ""
  each n in names { chunk = chunk + n + "  ◆  " }
  return el("div", { "class": "marquee" }, [
    el("div", { "class": "mq" }, [
      el("span", { "class": "mq-half" }, [chunk]),
      el("span", { "class": "mq-half" }, [chunk])
    ])
  ])
}

// --- projects: element tiles -----------------------------------------------------------

craft _tile(p, idx) {
  forge cls = "tile tile-" + p["accent"]
  when idx == 0 { cls = cls + " tile-feat" }
  return el("a", { "class": cls, "href": "/projects/" + p["slug"] }, [
    el("div", { "class": "tile-top" }, [
      el("span", { "class": "tile-num" }, [str(idx + 1)]),
      el("span", { "class": "tile-icon" }, [p["icon"]])
    ]),
    el("h3", { "class": "tile-name" }, [p["name"]]),
    el("p", { "class": "tile-tag" }, [p["tagline"]]),
    el("div", { "class": "tile-tags" }, _tags(p)),
    el("span", { "class": "tile-go" }, ["forge it →"])
  ])
}

craft _grid() {
  forge tiles = []
  forge i = 0
  each p in projects {
    tiles.shove(_tile(p, i))
    i = i + 1
  }
  return el("section", { "class": "section", "id": "projects" }, [
    el("div", { "class": "tab" }, [
      el("span", { "class": "td td-r" }, []),
      el("span", { "class": "td td-y" }, []),
      el("span", { "class": "td td-g" }, []),
      el("span", { "class": "tab-name" }, ["projects.cro"]),
      el("span", { "class": "tab-path" }, ["~/cococopi/src"])
    ]),
    el("div", { "class": "section-head" }, [
      el("h2", {}, ["the periodic table of the ecosystem"]),
      el("p", { "class": "section-sub" }, ["nine elements, one forge — each one built from scratch in corros. hover one to heat it up."])
    ]),
    el("div", { "class": "grid" }, tiles)
  ])
}

// --- stack: the circuit ----------------------------------------------------------------

craft _flow() {
  forge nodes = [
    { "b": "corros", "s": "the language" },
    { "b": "glazecraft", "s": "frontend" },
    { "b": "kilncraft", "s": "backend" },
    { "b": "courierforge", "s": "http" },
    { "b": "brothforge", "s": "html" },
    { "b": "oremath", "s": "math" },
    { "b": "cryoquench", "s": "ml engine" },
    { "b": "cryotorch", "s": "torch api" },
    { "b": "crucible", "s": "llm forge" }
  ]
  forge out = []
  forge i = 0
  each n in nodes {
    when i > 0 { out.shove(el("div", { "class": "flow-link" }, [])) }
    out.shove(el("div", { "class": "flow-node" }, [
      el("b", {}, [n["b"]]),
      el("span", {}, [n["s"]])
    ]))
    i = i + 1
  }
  return out
}

craft _stack() {
  return el("section", { "class": "section", "id": "stack" }, [
    el("div", { "class": "tab" }, [
      el("span", { "class": "td td-r" }, []),
      el("span", { "class": "td td-y" }, []),
      el("span", { "class": "td td-g" }, []),
      el("span", { "class": "tab-name" }, ["stack.cro"]),
      el("span", { "class": "tab-path" }, ["~/cococopi/src"])
    ]),
    el("div", { "class": "section-head" }, [
      el("h2", {}, ["the stack is one language"]),
      el("p", { "class": "section-sub" }, ["where other ecosystems need a dozen languages, corros does it with one — every layer feeds the next, and the data never changes vocabulary."])
    ]),
    el("div", { "class": "flow" }, _flow())
  ])
}

// --- about: ingots -----------------------------------------------------------------------

craft _about() {
  return el("section", { "class": "section", "id": "about" }, [
    el("div", { "class": "tab" }, [
      el("span", { "class": "td td-r" }, []),
      el("span", { "class": "td td-y" }, []),
      el("span", { "class": "td td-g" }, []),
      el("span", { "class": "tab-name" }, ["why.cro"]),
      el("span", { "class": "tab-path" }, ["~/cococopi/src"])
    ]),
    el("div", { "class": "section-head" }, [
      el("h2", {}, ["why"]),
      el("p", { "class": "section-sub" }, ["the point was never just another library. it was proving that a language written from scratch can grow its own complete ecosystem — and that the ecosystem can be faster, smaller, and easier to read than the originals it replaces."])
    ]),
    el("div", { "class": "about" }, [
      el("div", { "class": "about-card" }, [
        el("span", { "class": "about-k" }, ["01"]),
        el("h3", {}, ["self-hosting"]),
        el("p", {}, ["corros compiles corros: the compiler, the vm, and the aot backend are written in the language itself. the rust in the repo is only the bootstrap seed."])
      ]),
      el("div", { "class": "about-card" }, [
        el("span", { "class": "about-k" }, ["02"]),
        el("h3", {}, ["from scratch"]),
        el("p", {}, ["no vendored parsers, no third-party kernels, no framework-of-the-month. exp, log, softmax, html tokenizing, json, http, routing — all hand-written in corros."])
      ]),
      el("div", { "class": "about-card" }, [
        el("span", { "class": "about-k" }, ["03"]),
        el("h3", {}, ["fast where it counts"]),
        el("p", {}, ["aot compilation emits c and ties hand-written c; the cryoquench core hits 8.6 gflops on a phone. pure-corros reference implementations stay readable."])
      ])
    ])
  ])
}

// --- project detail page ----------------------------------------------------------------

craft _p_hero(p) {
  return el("section", { "class": "p-hero p-hero-" + p["accent"] }, [
    el("div", { "class": "p-hero-inner" }, [
      el("div", { "class": "p-icon" }, [p["icon"]]),
      el("h1", {}, [p["name"]]),
      el("p", { "class": "p-tagline" }, [p["tagline"]]),
      el("div", { "class": "p-tags" }, _tags(p)),
      el("div", { "class": "p-actions" }, [
        el("a", { "class": "btn btn-primary", "href": p["repo"] }, ["github ↗"]),
        el("a", { "class": "btn btn-ghost", "href": "/#projects" }, ["← all projects"])
      ])
    ])
  ])
}

craft _p_body(p, prev, next) {
  return el("section", { "class": "section p-body" }, [
    el("div", { "class": "p-desc" }, [
      el("h2", {}, ["about"]),
      el("p", {}, [p["desc"]])
    ]),
    _install_snippet(p),
    el("div", { "class": "p-nav" }, [
      el("a", { "class": "p-nav-link", "href": "/projects/" + prev["slug"] }, [
        el("span", {}, ["← previous"]),
        el("b", {}, [prev["name"]])
      ]),
      el("a", { "class": "p-nav-link p-nav-next", "href": "/projects/" + next["slug"] }, [
        el("span", {}, ["next →"]),
        el("b", {}, [next["name"]])
      ])
    ])
  ])
}

// --- page shell --------------------------------------------------------------------------

craft _page(title, body) {
  return "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">" +
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">" +
    "<meta name=\"description\" content=\"cococopi — nine projects, one language: corros, the from-scratch scripting language and its ecosystem.\">" +
    "<title>" + _glaze_esc(title) + "</title>" +
    "<link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🔥</text></svg>\">" +
    "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">" +
    "<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>" +
    "<link href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=JetBrains+Mono:wght@400;600&display=swap\" rel=\"stylesheet\">" +
    "<link rel=\"stylesheet\" href=\"/style.css\">" +
    "</head><body>" +
    _glaze_html_vnode(_nav()) +
    _glaze_html_vnode(body) +
    _glaze_html_vnode(_footer()) +
    "</body></html>"
}

craft _index() {
  return el("div", {}, [_hero(), _marquee(), _grid(), _stack(), _about()])
}

craft _project_page(p, prev, next) {
  return el("div", {}, [_p_hero(p), _p_body(p, prev, next)])
}

craft _notfound() {
  return el("div", { "class": "nf" }, [
    el("p", { "class": "nf-code" }, ["404"]),
    el("h1", {}, ["this page was never forged"]),
    el("p", {}, ["the foundry only fires nine projects."]),
    el("a", { "class": "btn btn-primary", "href": "/" }, ["back to the forge"])
  ])
}

// --- build ---------------------------------------------------------------------------------

craft _esc_xml(s) {
  return s.reforge("&", "&amp;").reforge("<", "&lt;").reforge(">", "&gt;")
}

craft main() {
  sys_exec("mkdir", ["-p", "dist/projects"])

  // static assets, copied in pure corros
  file_write("dist/style.css", read("public/style.css"))

  // index
  file_write("dist/index.html", _page("cococopi — forged in corros", _index()))

  // one page per project, with prev/next navigation
  forge n = size(projects)
  forge i = 0
  each p in projects {
    forge prev = projects[n - 1]
    forge next = projects[0]
    when i > 0 { prev = projects[i - 1] }
    when i < n - 1 { next = projects[i + 1] }
    file_write("dist/projects/" + p["slug"] + ".html", _page(p["name"] + " · cococopi", _project_page(p, prev, next)))
    i = i + 1
  }

  // 404
  file_write("dist/404.html", _page("404 — not forged", _notfound()))

  // sitemap + robots
  forge locs = ["https://cococopi-site.vercel.app/"]
  each p in projects { locs.shove("https://cococopi-site.vercel.app/projects/" + p["slug"]) }
  forge sitemap = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n"
  each u in locs {
    sitemap = sitemap + "  <url><loc>" + _esc_xml(u) + "</loc></url>\n"
  }
  sitemap = sitemap + "</urlset>\n"
  file_write("dist/sitemap.xml", sitemap)
  file_write("dist/robots.txt", "User-agent: *\nAllow: /\nSitemap: https://cococopi-site.vercel.app/sitemap.xml\n")

  speak("built " + str(size(locs)) + " pages into dist/")
  return nil
}

main()
